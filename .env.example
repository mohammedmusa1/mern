# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/Ecommerce-Products
# For MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/Ecommerce-Products

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRE=48h

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * to allow all (dev only).
CLIENT_URL=http://localhost:3000

# ── Seeding ───────────────────────────────────────────────────────────────────
SKIP_SEED_ON_START=false
FORCE_SEED_ON_START=false

# ── Pinecone (AI Recommendations) ─────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_HOST=https://your-index.svc.us-east-1.pinecone.io
PINECONE_INDEX=ecommerce-products
PINECONE_NAMESPACE=ecommerce-products
PINECONE_PURGE_ON_SYNC=false

# ── Google AI (Embeddings) ────────────────────────────────────────────────────
GOOGLE_AI_API_KEY=your-google-ai-api-key

# ── Weaviate (Optional) ───────────────────────────────────────────────────────
WEAVIATE_HOST=https://your-instance.weaviate.network
WEAVIATE_API_KEY=your-weaviate-api-key
RECOMMENDATION_PREFER_WEAVIATE=false

# ── Frontend (used by docker-compose) ────────────────────────────────────────
REACT_APP_API_BASE_URL=/api

# ── MongoDB Docker Init (used by docker-compose) ──────────────────────────────
MONGO_INITDB_DATABASE=Ecommerce-Products
